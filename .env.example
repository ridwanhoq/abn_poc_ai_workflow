APP_NAME="FlowForge AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=abn_ai_workflow
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must exceed the longest workflow timeout (max 3600 s).
DB_QUEUE_RETRY_AFTER=3900

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Workflow platform -------------------------------------------------
# Demo mode: every email is written to the log and outbound HTTP is simulated.
WORKFLOW_DEMO_MODE=true
# Finished executions older than this are pruned daily (model:prune).
WORKFLOW_RETENTION_DAYS=30
# Queue used for workflow jobs (default queue keeps `queue:work` sufficient).
WORKFLOW_QUEUE=default
# Max size of uploaded videos in KB.
WORKFLOW_MAX_UPLOAD_KB=51200
# Where uploaded media is stored: local or s3 (uses the AWS_* settings above).
WORKFLOW_UPLOAD_DISK=local
# Optional comma-separated allow-list of hosts for the Send Webhook Request node.
WORKFLOW_HTTP_ALLOWED_HOSTS=
# Max webhook request body in KB.
WORKFLOW_WEBHOOK_MAX_KB=256

# --- Real-time execution updates (optional, Laravel Reverb) -----------
# Off by default (the UI polls). To enable: set BROADCAST_CONNECTION=reverb, fill the
# REVERB_APP_* values with random strings, rebuild assets (npm run build) and run
# `php artisan reverb:start` (included in `composer dev`).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SERVER_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
